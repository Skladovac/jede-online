# Zkopíruj tento soubor jako ".env" a doplň své klíče.

# Token Telegram bota od @BotFather (vypadá jako 123456789:AAH...)
TELEGRAM_BOT_TOKEN=

# Který AI model pohání Alexe: claude nebo deepseek
LLM_PROVIDER=

# API klíč z https://platform.claude.com, sekce API Keys (začíná sk-ant-)
ANTHROPIC_API_KEY=

# API klíč z https://platform.deepseek.com, sekce API Keys (začíná sk-)
DEEPSEEK_API_KEY=

# Model DeepSeek. Kdyby ho DeepSeek přejmenoval, změň ho tady.
DEEPSEEK_MODEL=deepseek-flash

# Model Claude (jen když LLM_PROVIDER=claude). Výchozí je Haiku 5.5: rychlý a velmi levný.
# Dražší a kvalitnější varianty: claude-sonnet-5-5 (cca 20x dražší), claude-opus-5-5 (cca 40x dražší)
CLAUDE_MODEL=claude-haiku-5-5

# Jak moc má model přemýšlet před odpovědí: low | medium | high
# low = nejrychlejší, medium = výchozí (lépe drží postavu a pravidla), high = nejpřísněji drží pravidla
CLAUDE_EFFORT=medium

# Soubor s databází (historie, paměť)
DB_PATH=data/alex.db

# Kolik sekund počkat na další zprávu, než Alex odpoví (lidé často píšou víc zpráv za sebou)
REPLY_DEBOUNCE_SECONDS=4

# Simulace psaní (Alex "píše..." podle délky zprávy). 0 = vypnuto
TYPING_SIMULATION=1

# Zpomalení odpovědí: 1 = základní rychlost, 1.5 = o 50 % pomalejší (výchozí), 2 = dvakrát pomalejší
DELAY_MULTIPLIER=1.5

# Kolik zpráv denně může uživatel bez předplatného poslat (počítá se od půlnoci)
FREE_MESSAGES_PER_DAY=30

# Cena předplatného na 30 dní v Telegram Stars (obnovuje se automaticky)
SUBSCRIPTION_STARS=400

# Předplatné zdarma pro prvních tolik nových uživatelů (po potvrzení 18+), 0 = vypnuto.
# Každý ho dostane nejvýš jednou, správci se nepočítají.
PROMO_PREMIUM_USERS=0
# Na kolik dní
PROMO_PREMIUM_DAYS=7

# Kolik fotek může Alex jedné uživatelce poslat za den (0 = žádné fotky)
PHOTOS_PER_DAY=1

# Bez požádání pošle fotku nanejvýš jednou za tolik dní (když si o ni řekne, platí jen denní limit)
PHOTO_UNSOLICITED_DAYS=3

# Kolikrát nejdřív hravě odmítne ("dělá drahoty"), než fotku na požádání pošle
PHOTO_TEASE_REFUSALS=2

# Ukázková fotka: každý nový uživatel ji dostane v prvních 3 dnech po tolika svých zprávách (0 = vypnuto).
# Pro všechny stejně, bez ohledu na limit nebo předplatné.
SAMPLE_PHOTO_AFTER=8

# Skutečné počasí v Praze z MET Norway (1 = zapnuto, 0 = vypnuto). Zdarma i pro komerční použití.
WEATHER_ENABLED=1
# Kontakt na provozovatele (e-mail nebo web), který MET Norway žádá v každém dotazu. Vidí ho jen oni.
# Bez kontaktu to zatím funguje, ale MET si vyhrazuje dotazy bez kontaktu odmítat.
WEATHER_CONTACT=

# Kolik odpovědí na jeho zprávu „sám od sebe“ se nepočítá do limitu zpráv zdarma
FREE_REPLIES_AFTER_PROACTIVE=3

# Telegram ID majitele/správců (oddělená čárkou): píšou bez omezení a nic neplatí.
# Své ID zjistíš, když v Telegramu napíšeš botovi @userinfobot.
ADMIN_USER_IDS=

# Provozovatel a kontakt pro /terms (podmínky) a /paysupport (pomoc s platbami).
# Před spuštěním plateb je vyplň: jméno nebo firma a IČO, e-mail nebo @uživatel na Telegramu.
PROVOZOVATEL=
KONTAKT_PODPORA=

# Placení: 0 = zkušební provoz zdarma (bez limitu zpráv, bez předplatného, v menu nic o platbách),
# 1 = zapnout limit zpráv zdarma a předplatné za hvězdy (předtím vyplň PROVOZOVATEL a KONTAKT_PODPORA).
PAYMENTS_ENABLED=0
