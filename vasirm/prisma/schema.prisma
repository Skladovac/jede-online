// vasirm — web realitních makléřů VRM (Markéta a Ondřej Nedbálkovi, Zlín).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Makléř = zároveň účet do administrace. Veřejné údaje (telefon, e-mail, fotka) jsou na webu.
model User {
  id            String         @id @default(cuid())
  email         String         @unique /// přihlašovací e-mail
  passwordHash  String
  name          String
  slug          String         @unique
  role          String         @default("realitní makléř")
  phone         String         @default("")
  publicEmail   String         @default("")
  bio           String         @default("") /// krátké představení (1–2 věty)
  /// Osobní příběh na osobní stránce (odstavce oddělené prázdným řádkem)
  story         String         @default("")
  /// Specializace — štítky (např. „rodinné domy“, „investiční byty“)
  specialties   String[]       @default([])
  yearsInField  Int?
  soldCount     Int?
  avgSaleDays   Int?
  /// Video představení (YouTube / Vimeo, adresa pro vložení). Prázdné = na webu skryté.
  videoUrl      String?
  photo         String? /// URL fotky (/img/... ze složky public, nebo /media/... nahraná)
  sort          Int            @default(0)
  createdAt     DateTime       @default(now())
  sessions      Session[]
  listings      Listing[]
  testimonials  Testimonial[]
  questionnaire Questionnaire?
}

/// Dotazník pro texty na web (příběh, specializace, čísla…). Jeden na makléře, ukládá se průběžně.
model Questionnaire {
  userId      String    @id
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers     Json      @default("{}")
  submittedAt DateTime?
  updatedAt   DateTime  @updatedAt
}

/// Společné údaje týmu na úvodní stránce (jediný řádek, id = 1).
model TeamSettings {
  id           Int    @id @default(1)
  yearsInField Int?
  soldCount    Int?
  avgSaleDays  Int?
  /// Společný příběh na stránce O nás
  story        String @default("")
}

/// Reference klienta. Na web jde jen se souhlasem klienta a když je zveřejněná.
model Testimonial {
  id            String   @id @default(cuid())
  quote         String
  clientName    String /// „Jana K.“
  clientPlace   String   @default("") /// „Zlín“
  propertyLabel String   @default("") /// „Prodej rodinného domu“
  agentId       String?
  agent         User?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  /// Fotka z prodané nemovitosti (první fotka)
  listingId     String?
  listing       Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  consent       Boolean  @default(false)
  published     Boolean  @default(false)
  sort          Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([published, sort])
}

model Session {
  id        String   @id /// sha256 tokenu z cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Odkud nemovitost pochází: ručně z administrace, nebo exportem z Realmanu (pak se upravuje jen v Realmanu).
enum ListingSource {
  MANUAL
  REALMAN
}

enum ListingStatus {
  DRAFT
  ACTIVE
  RESERVED
  SOLD
}

enum OfferType {
  SALE
  RENT
}

enum PropertyType {
  HOUSE
  FLAT
  LAND
  COMMERCIAL
  COTTAGE
  OTHER
}

model Listing {
  id              String         @id @default(cuid())
  slug            String         @unique
  /// Adresa ze starého WordPressu (/nemovitost/<legacySlug>/) — kvůli přesměrování a Googlu.
  legacySlug      String?        @unique
  source          ListingSource  @default(MANUAL)
  /// ID zakázky v Realmanu (/import/estate/{ID})
  externalId      String?        @unique
  /// Hodnota `updated` z posledního exportu
  externalUpdated String?
  /// Stažení fotek a videa z Realmanu: ok | pending | error
  syncState       String         @default("ok")
  syncError       String         @default("")
  syncAttempts    Int            @default(0)
  /// Poslední přijatá data z Realmanu (fotky a videa se stahují až po odpovědi)
  syncPayload     Json?
  /// Otisk aktuálně staženého videa (title|updated|url bez parametrů), ať se nestahuje znovu
  videoSourceKey  String?
  title           String
  status          ListingStatus  @default(DRAFT)
  offerType       OfferType      @default(SALE)
  propertyType    PropertyType   @default(HOUSE)
  locality        String /// „Zlín – Chlum“
  mapQuery        String         @default("") /// pro mapu, bez přesné adresy
  price           Int? /// null = cena v RK / na vyžádání
  priceNote       String         @default("")
  usableArea      Int?
  landArea        Int?
  disposition     String         @default("")
  energyClass     String? /// A–G (PENB), zákon ji v inzerci vyžaduje
  perex           String         @default("")
  description     String         @default("") /// odstavce oddělené prázdným řádkem
  params          Json           @default("[]") /// [{ label, value }]
  videoPath       String? /// relativně k MEDIA_DIR
  videoUrl        String? /// YouTube / Vimeo
  agentId         String?
  agent           User?          @relation(fields: [agentId], references: [id], onDelete: SetNull)
  featured        Boolean        @default(false)
  publishedAt     DateTime?
  soldAt          DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  images          ListingImage[]
  leads           Lead[]
  testimonials    Testimonial[]

  @@index([status, publishedAt])
}

model ListingImage {
  id           String   @id @default(cuid())
  listingId    String
  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sort         Int      @default(0)
  width        Int
  height       Int
  sizes        Int[] /// vygenerované šířky webp
  blur         String   @default("") /// malý náhled jako data URL
  alt          String   @default("")
  /// Otisk fotky z Realmanu (`hash`) — stejnou fotku podruhé nestahujeme
  externalHash String?
  createdAt    DateTime @default(now())

  @@index([listingId, sort])
}

/// Záznam každého volání exportu z Realmanu (pro kontrolu v administraci).
model RealmanLog {
  id         String   @id @default(cuid())
  externalId String
  method     String
  ok         Boolean
  message    String
  listingId  String?
  ip         String   @default("")
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

enum LeadType {
  VALUATION
  VIEWING
  CONTACT
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  DONE
  SPAM
}

model Lead {
  id        String     @id @default(cuid())
  type      LeadType
  status    LeadStatus @default(NEW)
  name      String
  email     String     @default("")
  phone     String     @default("")
  message   String     @default("")
  data      Json       @default("{}")
  listingId String?
  listing   Listing?   @relation(fields: [listingId], references: [id], onDelete: SetNull)
  source    String     @default("")
  note      String     @default("") /// interní poznámka makléřů
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status, createdAt])
}

// ───────────── návštěvnost (vlastní počítadlo bez cookies) ─────────────

/// Zobrazení stránky za den (cesta bez parametrů).
model PageStat {
  day   DateTime @db.Date
  path  String
  views Int      @default(0)

  @@id([day, path])
}

/// Unikátní návštěvník za den = anonymní otisk (sha256 dne, IP, prohlížeče a tajné soli).
model VisitorDay {
  day  DateTime @db.Date
  hash String   @db.Char(64)

  @@id([day, hash])
}

/// Odkud lidé přišli (první stránka návštěvy): Google, Seznam, Sreality, Facebook, přímo…
model SourceStat {
  day    DateTime @db.Date
  source String
  visits Int      @default(0)

  @@id([day, source])
}
