// vasirm — web realitních makléřů VRM (Markéta a Ondřej Nedbálkovi, Zlín).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Makléř = zároveň účet do administrace. Veřejné údaje (telefon, e-mail, fotka) jsou na webu.
model User {
  id           String    @id @default(cuid())
  email        String    @unique /// přihlašovací e-mail
  passwordHash String
  name         String
  slug         String    @unique
  role         String    @default("realitní makléř")
  phone        String    @default("")
  publicEmail  String    @default("")
  bio          String    @default("")
  photo        String? /// URL fotky (/img/... ze složky public, nebo /media/... nahraná)
  sort         Int       @default(0)
  createdAt    DateTime  @default(now())
  sessions     Session[]
  listings     Listing[]
}

model Session {
  id        String   @id /// sha256 tokenu z cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum ListingStatus {
  DRAFT
  ACTIVE
  RESERVED
  SOLD
}

enum OfferType {
  SALE
  RENT
}

enum PropertyType {
  HOUSE
  FLAT
  LAND
  COMMERCIAL
  COTTAGE
  OTHER
}

model Listing {
  id           String         @id @default(cuid())
  slug         String         @unique
  /// Adresa ze starého WordPressu (/nemovitost/<legacySlug>/) — kvůli přesměrování a Googlu.
  legacySlug   String?        @unique
  title        String
  status       ListingStatus  @default(DRAFT)
  offerType    OfferType      @default(SALE)
  propertyType PropertyType   @default(HOUSE)
  locality     String /// „Zlín – Chlum“
  mapQuery     String         @default("") /// pro mapu, bez přesné adresy
  price        Int? /// null = cena v RK / na vyžádání
  priceNote    String         @default("")
  usableArea   Int?
  landArea     Int?
  disposition  String         @default("")
  energyClass  String? /// A–G (PENB), zákon ji v inzerci vyžaduje
  perex        String         @default("")
  description  String         @default("") /// odstavce oddělené prázdným řádkem
  params       Json           @default("[]") /// [{ label, value }]
  videoPath    String? /// relativně k MEDIA_DIR
  videoUrl     String? /// YouTube / Vimeo
  agentId      String?
  agent        User?          @relation(fields: [agentId], references: [id], onDelete: SetNull)
  featured     Boolean        @default(false)
  publishedAt  DateTime?
  soldAt       DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  images       ListingImage[]
  leads        Lead[]

  @@index([status, publishedAt])
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sort      Int      @default(0)
  width     Int
  height    Int
  sizes     Int[] /// vygenerované šířky webp
  blur      String   @default("") /// malý náhled jako data URL
  alt       String   @default("")
  createdAt DateTime @default(now())

  @@index([listingId, sort])
}

enum LeadType {
  VALUATION
  VIEWING
  CONTACT
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  DONE
  SPAM
}

model Lead {
  id        String     @id @default(cuid())
  type      LeadType
  status    LeadStatus @default(NEW)
  name      String
  email     String     @default("")
  phone     String     @default("")
  message   String     @default("")
  data      Json       @default("{}")
  listingId String?
  listing   Listing?   @relation(fields: [listingId], references: [id], onDelete: SetNull)
  source    String     @default("")
  note      String     @default("") /// interní poznámka makléřů
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status, createdAt])
}
