# /opt/jede/vasirm.env — na serveru, mimo git (chmod 600).
# Databáze "vasirm" + uživatel "vasirm" ve sdíleném postgresu (host "db" v síti jede_default).
VASIRM_DATABASE_URL=postgresql://vasirm:ZMEN_HESLO@db:5432/vasirm?schema=public
# Veřejná adresa webu. Po přesunu: https://www.vasirm.cz a ALLOW_INDEXING=1
SITE_URL=https://vasirm.jede.online
ALLOW_INDEXING=0
# E-maily o nových poptávkách (Brevo). Prázdné = jen do logu.
BREVO_API_KEY=
# Kam posílat poptávky (čárkou). Prázdné = e-maily makléřů z administrace.
LEAD_EMAILS=
# Export z Realmanu — vlastní klíč (openssl rand -hex 16), předá se podpoře Realmanu do nastavení můstku.
# Výchozí klíč z jejich dokumentace NEPOUŽÍVAT (je v dokumentu, který dostávají všichni klienti).
REALMAN_API_KEY=
GIT_COMMIT=unknown
