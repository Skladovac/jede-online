# Lokální vývoj: npm run db:local (embedded Postgres na portu 5433)
DATABASE_URL="postgresql://vasirm:vasirm@localhost:5433/vasirm?schema=public"
# Kam se ukládají nahrané fotky a videa (v Dockeru /app/media)
MEDIA_DIR=./media
# Veřejná adresa webu (kanonické odkazy, sitemap, OG)
SITE_URL=http://localhost:3500
# 1 = povolit indexaci vyhledávači (jen na finální doméně)
ALLOW_INDEXING=0
# E-maily (Brevo). Bez klíče se poptávky jen vypíšou do logu.
BREVO_API_KEY=
# Kam chodí upozornění na poptávky (čárkou oddělené). Prázdné = e-maily makléřů z DB.
LEAD_EMAILS=
# Export z Realmanu: klíč (hlavička apikey, aspoň 32 znaků; openssl rand -hex 16). Lokálně povolit libovolnou IP.
REALMAN_API_KEY=
REALMAN_ALLOW_ANY_IP=1
