{
  "name": "vasirm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3500",
    "build": "prisma generate && next build",
    "build:docker": "prisma generate && next build",
    "start": "next start -p 3500",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/lib/*.test.ts",
    "db:local": "node scripts/dev-db.mjs",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "import:wp": "tsx --conditions=react-server scripts/import-wp.ts",
    "user:add": "tsx --conditions=react-server scripts/user-add.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "gsap": "^3.15.0",
    "lucide-react": "^0.460.0",
    "next": "^15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "undici": "^6.29.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "postcss": "^8.5.29",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
