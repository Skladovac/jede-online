datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  // Správce celé služby (napříč firmami). Příznak, záměrně NE role ve firmě.
  isSuperAdmin  Boolean  @default(false)
  remindEnabled Boolean  @default(true)
  createdAt     DateTime @default(now())

  sessions          Session[]
  memberships       Membership[]
  pushSubscriptions PushSubscription[]
  reminderLogs      ReminderLog[]
}

// Firma. Nastavení výkazu (první den období, hodina připomínky) patří firmě, ne osobě.
model Organization {
  id             String   @id @default(cuid())
  name           String
  reportName     String
  // První den období výkazu. 1 = kalendářní měsíc, 16 = období od 16. do 15.
  periodStartDay Int      @default(1)
  remindHour     Int      @default(19)
  createdAt      DateTime @default(now())

  memberships Membership[]
  periodLocks PeriodLock[]
}

// Hodnoty musí odpovídat ROLES v src/lib/role.ts.
enum Role {
  OWNER
  ACCOUNTANT
  EMPLOYEE
}

// Osoba x firma. Výkaz patří členství, ne uživateli: izolaci firem tak vynucuje jediný cizí klíč.
model Membership {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role       Role
  active     Boolean      @default(true)
  // Od kdy se u členství počítá, že má zapsáno. Bez tohohle by měsíční přehled
  // označil jako chybějící každý den před založením. U toho, kdo čas nezapisuje
  // (účetní), je to den založení.
  tracksFrom DateTime     @db.Date
  createdAt  DateTime     @default(now())

  entries    Entry[]
  changeLogs EntryChangeLog[]
  invitation Invitation?

  @@unique([userId, orgId])
  @@index([orgId])
}

model PeriodLock {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  periodKey  String
  lockedById String
  lockedAt   DateTime     @default(now())

  @@unique([orgId, periodKey])
}

// Auditní stopa úprav záznamů.
model EntryChangeLog {
  id           String     @id @default(cuid())
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  dayKey       String
  changedById  String
  changedAt    DateTime   @default(now())
  before       Json?
  after        Json?

  @@index([membershipId, dayKey])
}

// Pozvánka / obnova hesla. V DB jen sha256 tokenu.
model Invitation {
  id           String     @id // sha256(token)
  membershipId String     @unique
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  kind         String // "invite" | "reset"
  expiresAt    DateTime
  createdAt    DateTime   @default(now())
}

// Přihlášení: v cookie je náhodný token, v DB jen jeho SHA-256 (únik DB ≠ převzetí relací).
model Session {
  id        String   @id // sha256(token)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum EntryKind {
  WORK
  VACATION
  SICK
  DAYOFF
}

model Entry {
  id           String     @id @default(cuid())
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  day          DateTime   @db.Date
  kind         EntryKind  @default(WORK)
  hours        Decimal?   @db.Decimal(4, 2)
  fromTime     String? // "HH:MM"
  toTime       String? // "HH:MM"
  place        String?
  note         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Záměrně NE unique: jeden den může mít víc záznamů (dopoledne jinde než odpoledne).
  @@index([membershipId, day])
}

// Push notifikace: jeden řádek = jedno zařízení/prohlížeč (endpoint od push služby prohlížeče).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique @db.VarChar(1000)
  p256dh    String   @db.VarChar(200)
  auth      String   @db.VarChar(100)
  createdAt DateTime @default(now())

  @@index([userId])
}

// Záznam, že se ten den už pípalo. Unique na [userId, day] je pojistka proti dvojímu
// pípnutí, když se systemd timer po výpadku spustí znovu.
model ReminderLog {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    DateTime @db.Date
  sentAt DateTime @default(now())

  @@unique([userId, day])
}
