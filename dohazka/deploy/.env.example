# Vzor pro /opt/jede/dohazka.env (na serveru, chmod 600, NIKDY do gitu).
# Hodnoty piš bez uvozovek. Čte je docker compose (--env-file) i systemd (EnvironmentFile).

# Připojení k postgresu ve stacku landingu (host `db`, síť jede_default), např.
# postgresql://dohazka:HESLO@db:5432/dohazka   (heslo = to z init-db.sql)
DOHAZKA_DATABASE_URL=

# Tajemství pro večerní připomínku (volá ji systemd timer přes curl).
# POZOR: jen hex nebo base64 — žádné uvozovky, žádné zpětné lomítko.
# systemd service ho skládá do řádku `header = "Authorization: Bearer <tajemství>"`
# a " nebo \ by ten řádek rozbily. Generuj:  openssl rand -hex 32
CRON_SECRET=

# Klíče pro push notifikace. Generují se:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontakt pro push služby, např. mailto:tomas@jede.online
VAPID_SUBJECT=

# E-maily (pozvánky, obnova hesla) přes Resend. Bez klíče se e-mail neodešle; pozvánka přesto vznikne
# a admin to uvidí. Klíč patří jen do tohoto souboru na serveru.
RESEND_API_KEY=
# Základ odkazů v e-mailech. Prázdné = https://dohazka.jede.online
APP_URL=

# Volitelné: cesta k TTF fontu s češtinou pro PDF. Nech prázdné — image má DejaVu.
DOHAZKA_PDF_FONT=

# Doplňuje deploy-dohazka.sh sám (krátký hash nasazeného commitu). Nevyplňuj.
GIT_COMMIT=
