# /opt/jede/pokemon.env — na serveru, mimo git.
# Databáze "pokemon" + uživatel "pokemon" ve sdíleném postgresu (host "db" v síti jede_default).
POKEMON_DATABASE_URL=postgresql://pokemon:ZMEN_HESLO@db:5432/pokemon?schema=public
# E-maily: Brevo (preferovane), Resend jen zaloha
BREVO_API_KEY=
RESEND_API_KEY=
# Tajemstvi pro nocni import katalogu (cron na serveru): openssl rand -hex 24
CRON_SECRET=
GIT_COMMIT=unknown
