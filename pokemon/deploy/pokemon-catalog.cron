# Nocni import katalogu Pokemon karet (TCGdex) do pokemon.jede.online
30 3 * * * root . /opt/jede/pokemon.env && curl -fsS -X POST -H "Authorization: Bearer $CRON_SECRET" http://127.0.0.1:3400/api/cron/sync-catalog >> /var/log/pokemon-catalog.log 2>&1
# Denni e-mail o shodach (nekdo nabizi, co ti chybi) - odpoledne po skole (15 UTC = 17 v lete, 16 v zime)
0 15 * * * root . /opt/jede/pokemon.env && curl -fsS -X POST -H "Authorization: Bearer $CRON_SECRET" http://127.0.0.1:3400/api/cron/match-digest >> /var/log/pokemon-digest.log 2>&1 && echo >> /var/log/pokemon-digest.log
# Denni prepocet odznaku (pred e-mailem o shodach, upozorneni jdou do zvonecku)
45 14 * * * root . /opt/jede/pokemon.env && curl -fsS -X POST -H "Authorization: Bearer $CRON_SECRET" http://127.0.0.1:3400/api/cron/badges >> /var/log/pokemon-badges.log 2>&1 && echo >> /var/log/pokemon-badges.log
# Denni souhrn novych nabidek sledovanych sberatelu (do zvonecku)
50 14 * * * root . /opt/jede/pokemon.env && curl -fsS -X POST -H "Authorization: Bearer $CRON_SECRET" http://127.0.0.1:3400/api/cron/follow-digest >> /var/log/pokemon-follow.log 2>&1 && echo >> /var/log/pokemon-follow.log
