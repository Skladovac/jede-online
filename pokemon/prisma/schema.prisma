// pokemon.jede.online — datový model (fáze 0, návrh pro celé MVP).
// Katalog (CardSet, Card) se plní importem z TCGdex, zbytek tvoří uživatelé.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ── Katalog ─────────────────────────────────────────────────────────

model CardSet {
  id            String    @id // id ze zdroje katalogu, např. "sv01"
  // Karetní hra. Zatím jen "pokemon"; připraveno pro další hry (Magic, Yu-Gi-Oh!, …).
  game          String    @default("pokemon")
  language      String    @default("en") // en = anglické sady, ja = japonské (id s předponou „ja-“)
  name          String
  nameOriginal  String? // původní (japonský) název sady
  seriesId      String // éra, např. "sv"
  series        String // např. "Scarlet & Violet"
  code          String? // zkratka natištěná na kartě, např. "SVI"
  releaseDate   DateTime?
  cardCount     Int // včetně secret rare
  officialCount Int // číslo za lomítkem na kartě, např. 198
  logoUrl       String?
  symbolUrl     String?
  cards         Card[]
  products      Product[]
  syncedAt      DateTime  @updatedAt

  @@index([game, releaseDate])
  @@index([language])
  @@index([seriesId])
  @@index([code])
}

model Card {
  id             String   @id // např. "sv01-045"
  setId          String
  set            CardSet  @relation(fields: [setId], references: [id])
  localId        String // číslo v sadě, např. "045" (může obsahovat písmena, "TG01")
  name           String
  nameOriginal   String? // původní název u japonských karet (フシギダネ); name je anglicky
  category       String? // Pokemon / Trainer / Energy
  rarity         String?
  imageUrl       String? // bez přípony; /low.webp nebo /high.webp se doplní při zobrazení
  // Jaké varianty karta v tisku existuje (z katalogu).
  hasNormal      Boolean  @default(true)
  hasHolo        Boolean  @default(false)
  hasReverse     Boolean  @default(false)
  hasFirstEd     Boolean  @default(false)
  hasPokeball    Boolean  @default(false)
  hasMasterball  Boolean  @default(false)
  // Orientační ceny z Cardmarketu v EUR (průměr prodejů), aktualizuje noční import.
  priceEur        Decimal? @db.Decimal(10, 2)
  priceReverseEur Decimal? @db.Decimal(10, 2) // reverse holo verze
  // Podrobnosti z Cardmarketu: { low, trend, avg1, avg7, avg30, reverse?: {…} } v EUR
  priceStats      Json?
  priceUpdatedAt  DateTime?
  cmProductId     Int? // idProduct na Cardmarketu — ceny se berou přímo z jeho denního ceníku (čerstvější než TCGdex)

  items     CollectionItem[]
  wants     WantItem[]
  syncedAt  DateTime @updatedAt

  @@unique([setId, localId])
  @@index([name])
  @@index([cmProductId])
}

// ── Uživatelé ───────────────────────────────────────────────────────

enum Country {
  CZ
  SK
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  emailVerifiedAt DateTime?
  nickname     String   @unique
  birthYear    Int
  birthMonth   Int
  country      Country
  region       String? // kraj
  city         String?

  // Rodičovský souhlas (CZ pod 15, SK pod 16). Do schválení je účet omezený.
  isMinor             Boolean   @default(false)
  parentEmail         String?
  parentConsentAt     DateTime?
  parentConsentName   String?
  parentToken         String?   @unique // trvalý odkaz rodiče na správu účtu

  // Profil vidí kdokoliv; indexace Googlem jen po výslovném souhlasu.
  indexable     Boolean @default(false)
  facebookUrl   String?
  instagramUrl  String?
  aukroUrl      String?
  // Telefon jen u dospělých; zobrazí se přihlášenému po kliknutí (každé zobrazení se zapisuje).
  phone         String?  @db.VarChar(20)

  // Denní e-mail „někdo nabízí kartu, která ti chybí“ (jde vypnout v Můj účet).
  matchEmails   Boolean   @default(true)
  locale        String    @default("cs") @db.VarChar(5) // jazyk webu a e-mailů: cs / sk / en
  matchDigestAt DateTime? // do kdy už jsme shody poslali
  linksApprovedAt DateTime? // u nezletilých schvaluje rodič

  acceptedTermsAt DateTime?
  topBadge        String?   @db.VarChar(24) // nejlepší odznak pro ikonku u přezdívky, např. "reliable:3"

  // Pozvánky: kdo mě pozval; započítá se (odznak Ambasador) až po ověření e-mailu, 10 kartách a u dětí souhlasu rodiče.
  invitedById     String?
  invitedBy       User?     @relation("Invites", fields: [invitedById], references: [id], onDelete: SetNull)
  invited         User[]    @relation("Invites")
  inviteCountedAt DateTime?
  followDigestAt  DateTime? // do kdy už jsme poslali souhrn nových nabídek sledovaných
  lastSeenAt      DateTime? // naposledy na webu (zapisuje se nejvýš jednou za 10 minut)

  isAdmin     Boolean  @default(false)
  bannedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items          CollectionItem[]
  wants          WantItem[]
  sentRequests   TradeRequest[] @relation("RequestFrom")
  gotRequests    TradeRequest[] @relation("RequestTo")
  ratingsGiven   Rating[]       @relation("RatingFrom")
  ratingsGot     Rating[]       @relation("RatingTo")
  reportsMade    Report[]       @relation("ReportFrom")
  reportsAgainst Report[]       @relation("ReportAgainst")
  sessions       Session[]
  emailTokens    EmailToken[]
  productItems   ProductItem[]
  productWants   ProductWant[]
  bugReports     BugReport[]
  phoneViewsMade PhoneView[]    @relation("PhoneViewer")
  phoneViewsGot  PhoneView[]    @relation("PhoneOwner")
  notifications  Notification[]
  oauthAccounts  OAuthAccount[]
  badges         UserBadge[]
  activeDays     UserActiveDay[]
  following      Follow[]       @relation("Follower")
  followers      Follow[]       @relation("Following")

  @@index([country, region, city])
  @@index([invitedById])
}

// Přihlášení: v cookie je náhodný token, v DB jen jeho SHA-256 (únik DB ≠ převzetí relací).
model Session {
  id        String   @id // sha256(token)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum EmailTokenKind {
  VERIFY // potvrzení vlastního e-mailu
  RESET // zapomenuté heslo
}

model EmailToken {
  id        String         @id // sha256(token)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      EmailTokenKind
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  @@index([userId, kind])
}

// ── Sbírka ──────────────────────────────────────────────────────────

enum Variant {
  NORMAL
  HOLO
  REVERSE
  FIRST_EDITION
  POKEBALL // reverse holo se vzorem Poké Ball (např. Prismatic Evolutions, 151 JP)
  MASTERBALL // reverse holo se vzorem Master Ball
}

enum Condition {
  MINT
  LIGHT_PLAYED
  DAMAGED
}

enum OfferType {
  TRADE // vyměním
  SELL // prodám
  GIFT // daruji za poštovné
}

// Jeden řádek = konkrétní kusy jedné karty v jedné variantě/stavu/jazyce.
model CollectionItem {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId     String
  card       Card      @relation(fields: [cardId], references: [id])
  variant    Variant   @default(NORMAL)
  condition  Condition @default(MINT)
  language   String    @default("en")
  note       String?   @db.VarChar(30)
  quantity   Int       @default(1)
  // Kolik z toho je "navíc" a nabízí se.
  spareQty   Int       @default(0)
  offerType  OfferType?
  priceCzk   Int?
  hiddenAt   DateTime? // nabídku skryl správce
  offeredAt  DateTime? // kdy byla nabídka zveřejněna (nebo se změnil typ/cena) — pro „nejnovější“ a denní e-mail
  purchasePriceCzk Int? // nepovinná nákupní cena za kus (přehled: investováno, zisk/ztráta) — vidí jen majitel
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  requestItems TradeRequestItem[]

  @@unique([userId, cardId, variant, condition, language])
  @@index([cardId, spareQty])
}

// Chybějící karta (wishlist).
model WantItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id])
  variant   Variant? // null = je jedno jaká
  // „Chci koupit“: veřejná poptávka s nejvyšší cenou (nepovinná) a podmínkami.
  buy          Boolean    @default(false)
  maxPriceCzk  Int?
  minCondition Condition?
  language     String? // null = je jedno jaký
  buyAt        DateTime? // kdy byla poptávka „chci koupit“ zveřejněna (nebo se změnila cena)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, cardId, variant])
  @@index([cardId])
  @@index([cardId, buy])
}

// ── Poptávky a důvěra ───────────────────────────────────────────────

enum RequestStatus {
  DRAFT // košík kupujícího, ještě neodesláno
  PENDING
  ACCEPTED // kontakty zpřístupněny
  DECLINED
  CANCELLED
  COMPLETED // obě strany potvrdily dokončení
}

model TradeRequest {
  id          String        @id @default(cuid())
  fromId      String
  from        User          @relation("RequestFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId        String
  to          User          @relation("RequestTo", fields: [toId], references: [id], onDelete: Cascade)
  status      RequestStatus @default(DRAFT)
  sentAt      DateTime?
  respondedAt DateTime?
  fromDoneAt  DateTime?
  toDoneAt    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  items   TradeRequestItem[]
  ratings Rating[]

  @@index([toId, status])
  @@index([fromId, status])
}

// Položka poptávky. Údaje se při odeslání zkopírují (snapshot), aby poptávka dávala smysl,
// i když prodávající kartu ze sbírky mezitím odebere nebo změní cenu.
model TradeRequestItem {
  id               String          @id @default(cuid())
  requestId        String
  request          TradeRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  collectionItemId String?
  collectionItem   CollectionItem? @relation(fields: [collectionItemId], references: [id], onDelete: SetNull)
  // false = kus prodávajícího, který kupující chce; true = kus kupujícího nabídnutý na výměnu
  productItemId    String?
  productItem      ProductItem?    @relation(fields: [productItemId], references: [id], onDelete: SetNull)
  productId        Int?
  fromRequester    Boolean         @default(false)
  quantity         Int             @default(1)
  cardId           String?
  title            String
  detail           String
  imageUrl         String?
  offerType        OfferType?
  priceCzk         Int?

  @@index([requestId])
  @@index([collectionItemId])
  @@index([productItemId])
}

// Pozn.: migrace 20261010120000_pojistky přidává i částečné indexy, které Prisma neumí popsat:
//  unikátní WantItem(userId, cardId) WHERE variant IS NULL, TradeRequest(fromId, toId) WHERE status='DRAFT',
//  Rating(fromId, toId) WHERE requestId IS NULL a indexy nabídek/poptávek podle offeredAt/buyAt (migrace 20261011090000).

enum RatingTag {
  FAST_SHIPPING
  AS_DESCRIBED
  FRIENDLY
  SLOW
  NOT_AS_DESCRIBED
  NOT_SENT
}

// Hodnocení: buď po dokončené výměně na webu (requestId = ověřené), nebo volné od registrovaného
// uživatele (requestId null, max. jedno od každého uživatele) — např. po obchodu domluveném mimo web.
model Rating {
  id        String        @id @default(cuid())
  requestId String?
  request   TradeRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fromId    String
  from      User         @relation("RatingFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        User         @relation("RatingTo", fields: [toId], references: [id], onDelete: Cascade)
  positive  Boolean
  tag       RatingTag?
  comment   String?      @db.VarChar(300)
  hiddenAt  DateTime? // skryl správce
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now()) @updatedAt

  @@unique([requestId, fromId])
  @@index([toId])
  @@index([fromId, toId])
}

model Report {
  id         String    @id @default(cuid())
  fromId     String
  from       User      @relation("ReportFrom", fields: [fromId], references: [id], onDelete: Cascade)
  againstId  String
  against    User      @relation("ReportAgainst", fields: [againstId], references: [id], onDelete: Cascade)
  reason     String    @db.VarChar(500)
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([resolvedAt])
}

// ── Zapečetěné produkty (ETB, boostery, tins, mince…) ──────────────
// Katalog z Cardmarketu (products_nonsingles + price_guide), obrázky z TCGplayeru.

enum ProductKind {
  BOOSTER
  DISPLAY // booster box, bundle, display
  ETB
  TIN
  BLISTER
  BOX_SET // kolekce, premium boxy
  THEME_DECK
  TRAINER_KIT
  COIN
  OTHER
}

model Product {
  id             Int         @id // idProduct na Cardmarketu
  game           String      @default("pokemon")
  name           String
  kind           ProductKind
  cmExpansionId  Int
  setId          String? // naše sada, pokud ji jde určit
  set            CardSet?    @relation(fields: [setId], references: [id])
  imageUrl       String?
  imageCheckedAt DateTime? // kdy se naposledy hledal obrázek (hledá se nejvýš 1× za 30 dní)
  priceEur       Decimal?    @db.Decimal(10, 2)
  priceStats     Json? // { low, trend, avg1, avg7, avg30 } v EUR
  priceUpdatedAt DateTime?
  addedAt        DateTime?
  syncedAt       DateTime    @updatedAt

  items ProductItem[]
  wants ProductWant[]

  @@index([setId])
  @@index([kind])
  @@index([name])
}

// Produkt ve sbírce. Vždy zapečetěný; jazyk rozlišuje (EN/DE/JP…).
model ProductItem {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product    @relation(fields: [productId], references: [id])
  language  String     @default("en")
  quantity  Int        @default(1)
  spareQty  Int        @default(0)
  offerType OfferType?
  priceCzk  Int?
  note      String?    @db.VarChar(30)
  hiddenAt  DateTime? // nabídku skryl správce
  offeredAt DateTime? // kdy byla nabídka zveřejněna (nebo se změnil typ/cena)
  purchasePriceCzk Int? // nepovinná nákupní cena za kus — vidí jen majitel
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  requestItems TradeRequestItem[]

  @@unique([userId, productId, language])
  @@index([productId, spareQty])
}

model ProductWant {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  // „Chci koupit“ s nejvyšší cenou (nepovinná).
  buy         Boolean  @default(false)
  maxPriceCzk Int?
  buyAt       DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, productId])
  @@index([productId])
}

// ── Správa ─────────────────────────────────────────────────────────

enum BugStatus {
  NEW
  IN_PROGRESS
  DONE
}

// Hlášení chyby z patičky webu (i od nepřihlášených).
model BugReport {
  id        String    @id @default(cuid())
  message   String    @db.VarChar(2000)
  pageUrl   String?   @db.VarChar(500)
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  contact   String?   @db.VarChar(200) // e-mail, pokud ho nepřihlášený vyplní
  userAgent String?   @db.VarChar(300)
  status    BugStatus @default(NEW)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, createdAt])
}

// Zakázaná slova v přezdívkách, která doplnil správce (k výchozímu seznamu v kódu).
model BannedWord {
  word      String   @id
  createdAt DateTime @default(now())
}

// Kdo si zobrazil čí telefon (ochrana proti sběru čísel, přehled pro správce).
model PhoneView {
  id        String   @id @default(cuid())
  viewerId  String
  viewer    User     @relation("PhoneViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  ownerId   String
  owner     User     @relation("PhoneOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([viewerId, createdAt])
  @@index([ownerId, createdAt])
}

// ── Návštěvnost (bez cookies, bez třetích stran) ──────────────────────
// Denní počty zobrazení po stránkách.
model PageStat {
  day   DateTime @db.Date
  path  String   @db.VarChar(200)
  views Int      @default(0)

  @@id([day, path])
}

// Unikátní návštěvníci za den: jen otisk sha256(den + IP + prohlížeč + tajemství), z něj nejde zjistit, kdo to byl.
// Maže se po 60 dnech.
model VisitorDay {
  day  DateTime @db.Date
  hash String   @db.Char(64)

  @@id([day, hash])
}

// Denní snímek hodnoty sbírky (graf vývoje v přehledu). Ukládá noční cron a první otevření přehledu za den.
model ValueSnapshot {
  userId      String
  day         DateTime @db.Date
  valueCzk    Int
  investedCzk Int      @default(0)

  @@id([userId, day])
}

// Upozornění na webu (zvoneček v liště): nová žádost o výměnu, odpověď, hodnocení, shody…
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String    @db.VarChar(200)
  body      String?   @db.VarChar(500)
  url       String?   @db.VarChar(300)
  icon      String?   @db.VarChar(8)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// Historie ceny karty (graf na detailu). Ukládá se jen den, kdy se cena změnila (+ první den), ať tabulka neroste zbytečně.
model CardPrice {
  cardId     String
  day        DateTime @db.Date
  eur        Decimal? @db.Decimal(10, 2)
  reverseEur Decimal? @db.Decimal(10, 2)

  @@id([cardId, day])
}

// Přihlášení přes Google / Facebook (propojený účet). Heslo uživatel mít nemusí.
model OAuthAccount {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String // google | facebook
  providerId String // id uživatele u poskytovatele
  createdAt  DateTime @default(now())

  @@unique([provider, providerId])
  @@index([userId])
}

// Odznaky: úroveň 1–4 (bronz, stříbro, zlato, legendární; jednorázové mají 1). Získané zůstávají navždy,
// jen „Spolehlivý“ se přepočítává podle hodnocení (level může klesnout, maxLevel hlídá, ať upozornění nechodí znovu).
model UserBadge {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     String   @db.VarChar(20)
  level     Int
  maxLevel  Int
  earnedAt  DateTime @default(now()) // kdy byla dosažena aktuální úroveň
  updatedAt DateTime @updatedAt

  @@id([userId, badge])
}

// Sledování sběratele (ručně tlačítkem, nebo automaticky oboustranně po registraci přes pozvánku).
model Follow {
  followerId  String
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followingId])
}

// Dny, kdy byl uživatel na webu (statistika „aktivní uživatelé po dnech“ v administraci).
model UserActiveDay {
  day    DateTime @db.Date
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([day, userId])
}
