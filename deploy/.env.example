# /opt/jede/.env — na serveru, NIKDY v gitu.
# Každou proměnnou je nutné vypsat i v docker-compose.yml, jinak do kontejneru nedojde.

# ── PostgreSQL (kontejner db, jen 127.0.0.1) ──
POSTGRES_USER=jede
POSTGRES_PASSWORD=<vygenerovat: openssl rand -base64 32>
POSTGRES_DB=postgres

# ── Landing jede.online ──
# Lokální DB na serveru:
LANDING_DATABASE_URL=postgresql://jede:<heslo>@db:5432/jede_landing?schema=public
LANDING_DIRECT_URL=postgresql://jede:<heslo>@db:5432/jede_landing?schema=public
# (Dokud běží Neon jako cesta zpět, jde sem beze změny kódu i Neon connection string.)

RESEND_API_KEY=re_...

# ── Verze — dopisuje deploy skript, needituj ručně (pojistka 6) ──
GIT_COMMIT=unknown
